# Copier ce fichier en `.env.local` (jamais commité) et remplir les valeurs.
# Sur Vercel : Settings → Environment Variables (mêmes noms).

# — Supabase (Dashboard → Settings → API) —
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # clé "service_role" (secrète, jamais côté client)

# — Admin —
ADMIN_PASSWORD=choisis-un-mot-de-passe-solide
# Optionnel : secret distinct pour signer les sessions (sinon dérivé du mot de passe)
# ADMIN_SESSION_SECRET=une-longue-chaine-aleatoire
